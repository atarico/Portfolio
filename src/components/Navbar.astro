---
// `cmd` es el mismo comando que encabeza cada sección: en mobile el navbar lo
// escribe al lado del prompt según la sección activa.
const links = [
  { href: '#experience', label: 'Experiencia', cmd: 'git log --experience' },
  { href: '#projects',   label: 'Proyectos',   cmd: 'ls ./proyectos'       },
  { href: '#about',      label: 'Sobre mí',    cmd: 'cat about.md'         },
  { href: '#tech',       label: 'Skills',      cmd: 'npm list --skills'    },
  { href: '#contact',    label: 'Contacto',    cmd: 'ssh atarico@contacto' },
];

// El scrollspy solo observa las secciones que tienen link en el menú; `#hero` queda
// fuera a propósito, porque el tope de la página no marca ninguna.
const navSectionIds = links.map(({ href }) => href.slice(1));
---

<!-- Barra flotante centrada, al estilo porfolio.dev.
     `data-sections` viaja por atributo y no por `define:vars`: eso último obligaría a
     un script inline, y el CSP de vercel.json solo permite `script-src 'self'`. -->
<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 flex flex-col items-center px-4 pt-3"
  data-sections={navSectionIds.join(',')}
>
  <nav
    class="nav-pill flex items-center justify-between md:justify-center gap-3 md:gap-5 w-full max-w-md md:w-auto md:max-w-none px-4 md:px-5 py-2 transition-all duration-300"
    aria-label="Navegación principal"
  >
    <!-- Prompt de terminal. Solo en mobile, donde los links viven en el
         desplegable y la píldora quedaría con el hamburguesa solo.
         El comando es decorativo (`aria-hidden`): la sección activa ya se
         anuncia con `aria-current` en los links del menú. -->
    <div class="nav-prompt md:hidden flex items-center min-w-0 select-none">
      <a
        href="#hero"
        class="logo flex items-center shrink-0"
        aria-label="Agustín Tarico — inicio"
      >
        <span class="text-body/60" aria-hidden="true">~/</span>
        <span class="text-accent font-medium">atarico</span>
      </a>
      <span class="text-body/60 ml-2 shrink-0" aria-hidden="true">$</span>
      <span id="nav-cmd" class="nav-cmd" aria-hidden="true"></span>
      <span class="cursor-blink shrink-0 ml-1 text-accent font-bold" aria-hidden="true">_</span>
    </div>

    <!-- Desktop navigation -->
    <ul class="hidden md:flex items-center gap-5" role="list">
      {links.map(({ href, label, cmd }) => (
        <li>
          <a
            href={href}
            data-cmd={cmd}
            class="nav-link text-body/80 hover:text-accent text-sm tracking-wider uppercase transition-colors duration-200"
            aria-current="false"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Hamburger button (mobile) -->
    <button
      id="menu-toggle"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden flex flex-col justify-center gap-1.25 w-8 h-8 p-1 text-accent rounded"
    >
      <span class="hamburger-bar block w-full h-px bg-current origin-center transition-all duration-300"></span>
      <span class="hamburger-bar block w-full h-px bg-current transition-all duration-300"></span>
      <span class="hamburger-bar block w-full h-px bg-current origin-center transition-all duration-300"></span>
    </button>
  </nav>

  <!-- Mobile menu: panel flotante debajo de la píldora -->
  <div
    id="mobile-menu"
    class="mobile-menu hidden md:hidden w-full max-w-sm mt-2"
    role="navigation"
    aria-label="Menú de navegación móvil"
  >
    <ul class="flex flex-col py-3 px-5" role="list">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="mobile-link block text-muted hover:text-accent text-sm tracking-widest uppercase transition-colors duration-200 py-3 border-b border-(--border-accent) last:border-0"
            aria-current="false"
          >
            <span class="text-accent opacity-60 mr-2 font-bold" aria-hidden="true">&gt;</span>{label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Refracción de la píldora. Solo Chromium aplica filtros SVG en backdrop-filter;
       el script dibuja el mapa de desplazamiento con el tamaño real de la píldora y
       mueve la intensidad con el scroll. -->
  <svg class="nav-glass-defs" aria-hidden="true" focusable="false">
    <filter id="nav-glass" color-interpolation-filters="sRGB">
      <feImage id="nav-glass-map" x="0" y="0" preserveAspectRatio="none" result="map" />
      <feDisplacementMap
        id="nav-glass-displace"
        in="SourceGraphic"
        in2="map"
        scale="0"
        xChannelSelector="R"
        yChannelSelector="G"
        result="refracted"
      />
      <feGaussianBlur id="nav-glass-blur" in="refracted" stdDeviation="0" result="soft" />
      <feColorMatrix id="nav-glass-saturate" in="soft" type="saturate" values="1" />
    </filter>
  </svg>
</header>

<script>
  const navbar     = document.getElementById('navbar')!;
  const toggle     = document.getElementById('menu-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const bars       = navbar.querySelectorAll<HTMLElement>('.hamburger-bar');

  /* ────────────────────────────────────────────────
   * Hamburger menu
   * ──────────────────────────────────────────────── */
  let open = false;

  const closeMenu = () => {
    if (!open) return;
    open = false;
    toggle.setAttribute('aria-expanded', 'false');
    mobileMenu.classList.add('hidden');
    document.body.style.overflow = '';
    bars[0]!.style.transform = '';
    bars[1]!.style.opacity   = '1';
    bars[2]!.style.transform = '';
  };

  const openMenu = () => {
    open = true;
    toggle.setAttribute('aria-expanded', 'true');
    mobileMenu.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    bars[0]!.style.transform = 'translateY(6px) rotate(45deg)';
    bars[1]!.style.opacity   = '0';
    bars[2]!.style.transform = 'translateY(-6px) rotate(-45deg)';
  };

  toggle.addEventListener('click', () => (open ? closeMenu() : openMenu()));

  // Cerrar al hacer click/tap fuera del navbar
  document.addEventListener('click', (e) => {
    if (open && !navbar.contains(e.target as Node)) closeMenu();
  });

  // Cerrar al hacer click en un link del menú mobile
  mobileMenu.querySelectorAll('.mobile-link').forEach(link =>
    link.addEventListener('click', closeMenu)
  );

  // Cerrar con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) closeMenu();
  });

  /* ────────────────────────────────────────────────
   * Scrollspy: sección activa según posición de scroll
   * ──────────────────────────────────────────────── */
  // Solo las secciones que tienen link en el menú, en orden de documento. Se filtra por
  // `section[id]` (y no por el orden del menú) para que un reorden de la página no
  // desincronice la búsqueda de "última sección que cruzó la línea".
  const navSectionIds = (navbar.dataset.sections ?? '').split(',').filter(Boolean);
  const sections = [...document.querySelectorAll<HTMLElement>('section[id]')]
    .filter((section) => navSectionIds.includes(section.id));

  const desktopLinks = navbar.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const mobileLinks  = mobileMenu.querySelectorAll<HTMLAnchorElement>('.mobile-link');
  const allNavLinks  = [...desktopLinks, ...mobileLinks];

  // En mobile el prompt escribe el comando de la sección activa. Vacío = estamos
  // en el hero y solo se ve `~/atarico $ _`.
  const cmdEl = document.getElementById('nav-cmd');

  const setActive = (id: string) => {
    allNavLinks.forEach((link) => {
      const isActive = link.getAttribute('href') === `#${id}`;
      link.classList.toggle('nav-link--active', isActive);
      link.setAttribute('aria-current', isActive ? 'true' : 'false');
    });

    if (cmdEl) {
      const match = [...desktopLinks].find(
        (link) => link.getAttribute('href') === `#${id}`
      );
      cmdEl.textContent = match?.dataset.cmd ?? '';
    }
  };

  const getActiveSection = () => {
    // Si llegamos al final de la página, la última sección es la activa aunque
    // su top no haya cruzado la línea de referencia (secciones cortas al pie).
    const scrolledToBottom =
      window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    if (scrolledToBottom) {
      return sections[sections.length - 1]?.id ?? '';
    }

    // Línea de referencia en el centro del viewport: una sección se marca activa
    // cuando su top la cruza, es decir, cuando ya domina lo que el usuario ve.
    // Robusto tanto para secciones cortas como más altas que el viewport.
    // Cadena vacía = ninguna sección del menú domina todavía (estamos en el hero).
    const line = window.innerHeight / 2;
    let current = '';
    sections.forEach((section) => {
      if (section.getBoundingClientRect().top <= line) {
        current = section.id;
      }
    });
    return current;
  };

  /* ────────────────────────────────────────────────
   * Vidrio líquido: refracción de lo que pasa detrás de la píldora.
   * Solo Chromium aplica filtros SVG en backdrop-filter, y `userAgentData` solo
   * existe en Chromium. El resto se queda con el vidrio esmerilado de CSS.
   * ──────────────────────────────────────────────── */
  const pill          = navbar.querySelector<HTMLElement>('.nav-pill')!;
  const glassMap      = document.getElementById('nav-glass-map')!;
  const glassDisplace = document.getElementById('nav-glass-displace')!;
  const glassBlur     = document.getElementById('nav-glass-blur')!;
  const glassSaturate = document.getElementById('nav-glass-saturate')!;
  const refracts      = 'userAgentData' in navigator;

  // Desplazamiento máximo con la píldora llena, relativo a su radio. Con el perfil
  // cuadrático del mapa, arriba de 0.5 el canto pliega la imagen como el borde de un
  // vidrio real; 0.6 deja ese pliegue fino sin dar vuelta todo lo que pasa detrás.
  const GLASS_STRENGTH = 0.6;
  let glassScale = 0;

  // Mapa de desplazamiento: cada píxel cerca del borde toma la imagen de un punto
  // más adentro, así lo que pasa por detrás se estira y se curva como en el canto
  // de un vidrio grueso. En el eje central no hay desplazamiento.
  // R codifica el desplazamiento en x y G en y; 128 es neutro.
  const drawGlassMap = () => {
    const w = Math.round(pill.offsetWidth);
    const h = Math.round(pill.offsetHeight);
    if (!w || !h) return;

    const r = h / 2; // border-radius: 9999px, los extremos son semicírculos
    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d')!;
    const map = ctx.createImageData(w, h);

    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        // Vector desde el eje central de la píldora hasta el píxel.
        const ox = x + 0.5 - w / 2;
        const dx = Math.sign(ox) * Math.max(Math.abs(ox) - (w / 2 - r), 0);
        const dy = y + 0.5 - h / 2;
        const dist = Math.hypot(dx, dy);

        let vx = 0;
        let vy = 0;
        if (dist > 0 && dist < r) {
          const edge = (dist / r) ** 2; // 0 en el eje, 1 en el borde
          vx = (-dx / dist) * edge;
          vy = (-dy / dist) * edge;
        }

        const i = (y * w + x) * 4;
        map.data[i]     = 128 + vx * 127;
        map.data[i + 1] = 128 + vy * 127;
        map.data[i + 2] = 128;
        map.data[i + 3] = 255;
      }
    }

    ctx.putImageData(map, 0, 0);
    glassMap.setAttribute('href', canvas.toDataURL());
    glassMap.setAttribute('width', String(w));
    glassMap.setAttribute('height', String(h));
    // feDisplacementMap desplaza `scale * (canal - 0.5)`: el doble del máximo.
    glassScale = 2 * GLASS_STRENGTH * r;
  };

  // La intensidad sigue a `--navbar-fill`, igual que el tinte y el borde: en el tope
  // de la página la píldora no se ve y tampoco deforma lo que tiene detrás.
  const updateGlass = () => {
    const fill = parseFloat(getComputedStyle(pill).getPropertyValue('--navbar-fill')) || 0;
    glassDisplace.setAttribute('scale', String(glassScale * fill));
    glassBlur.setAttribute('stdDeviation', String(2.5 * fill));
    glassSaturate.setAttribute('values', String(1 + 0.6 * fill));
  };

  if (refracts) {
    navbar.classList.add('navbar-refract');
    drawGlassMap();
    // El ancho cambia con el layout (mobile/desktop) y cuando cargan las fuentes.
    new ResizeObserver(() => {
      drawGlassMap();
      updateGlass();
    }).observe(pill);
  }

  /* ────────────────────────────────────────────────
   * Scroll: fondo semi-transparente + scrollspy.
   * Un solo listener, throttled con requestAnimationFrame.
   * ──────────────────────────────────────────────── */
  let lastActive = '';

  const onScroll = () => {
    navbar.classList.toggle('navbar-scrolled', window.scrollY > 30);
    if (refracts) updateGlass();
    const current = getActiveSection();
    if (current !== lastActive) {
      lastActive = current;
      setActive(current);
    }
  };

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      onScroll();
      ticking = false;
    });
  }, { passive: true });

  // Al redimensionar: cerrar el menú mobile si se pasa al layout desktop (el CSS
  // lo oculta en md pero el body quedaría sin scroll) y refrescar el scrollspy
  // sin esperar al próximo scroll.
  // 768px = breakpoint `md` de Tailwind, el mismo que oculta el menú.
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) closeMenu();
    onScroll();
  }, { passive: true });

  // Estado inicial correcto sin esperar al primer scroll
  onScroll();
</script>

<style>
  /* El fondo del navbar se deriva por completo de `--navbar-fill` (0 → 1, registrada
     en global.css). Así el estado "lleno" se declara una sola vez y las dos rutas de
     abajo solo mueven el número.
     El borde existe siempre a 1px transparente: animar `border-bottom-color` en vez
     de aparecer el borde evita que el contenido salte 1px al scrollear. */
  /* El header solo posiciona; el fondo vive en la píldora flotante. */
  #navbar {
    pointer-events: none;
  }

  .nav-pill,
  .mobile-menu {
    pointer-events: auto;
  }

  /* El fondo se deriva por completo de `--navbar-fill` (0 → 1, registrada en
     global.css). Así el estado "lleno" se declara una sola vez y las dos rutas de
     abajo solo mueven el número.
     Vidrio al estilo del dock de macOS: tinte oscuro translúcido con un velo claro
     que cae de arriba, blur con saturación para que lo de atrás se lea como color y
     no como gris, y luz especular en el borde (más fuerte arriba a la izquierda).
     Esta es la versión esmerilada para Safari y Firefox; en Chromium la reemplaza
     la refracción de `.navbar-refract`, más abajo. */
  .nav-pill {
    border-radius: 9999px;
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, calc(0.09 * var(--navbar-fill))),
        rgba(255, 255, 255, calc(0.02 * var(--navbar-fill)))
      ),
      rgba(10, 10, 10, calc(0.45 * var(--navbar-fill)));
    backdrop-filter:
      blur(calc(16px * var(--navbar-fill)))
      saturate(calc(1 + 0.8 * var(--navbar-fill)));
    -webkit-backdrop-filter:
      blur(calc(16px * var(--navbar-fill)))
      saturate(calc(1 + 0.8 * var(--navbar-fill)));
    border: 1px solid rgba(255, 255, 255, calc(0.12 * var(--navbar-fill)));
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, calc(0.3 * var(--navbar-fill))),
      inset -1px -1px 0 rgba(255, 255, 255, calc(0.1 * var(--navbar-fill))),
      inset 0 0 16px rgba(255, 255, 255, calc(0.06 * var(--navbar-fill))),
      0 10px 30px rgba(0, 0, 0, calc(0.45 * var(--navbar-fill)));
  }

  /* Refracción (solo Chromium, la clase la pone el script): el filtro SVG deforma lo
     que pasa por detrás y su intensidad la mueve el script con `--navbar-fill`.
     El tinte baja y el blur queda en unos pocos px para que la deformación se vea
     sin que lo de atrás compita con los links. */
  #navbar.navbar-refract .nav-pill {
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, calc(0.08 * var(--navbar-fill))),
        rgba(255, 255, 255, calc(0.02 * var(--navbar-fill)))
      ),
      rgba(10, 10, 10, calc(0.35 * var(--navbar-fill)));
    backdrop-filter: url(#nav-glass);
    -webkit-backdrop-filter: url(#nav-glass);
  }

  /* El SVG solo aporta el filtro: no ocupa lugar ni se ve. */
  .nav-glass-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* Ruta moderna: el fondo aparece gradual, atado a la posición de scroll. */
  @keyframes navbar-fill {
    to {
      --navbar-fill: 1;
    }
  }

  @supports (animation-timeline: scroll()) {
    .nav-pill {
      animation: navbar-fill linear forwards;
      animation-timeline: scroll();
      animation-range: 0 120px;
    }
  }

  /* Fallback: el script agrega `.navbar-scrolled` a los 30px y la transición del
     header lo suaviza.
     Va dentro de `@supports not` a propósito: una declaración normal le gana a la
     animación sobre `--navbar-fill`, así que si la clase aplicara en la ruta moderna
     el fondo saltaría a full apenas cruza los 30px y el degradado no se vería. */
  @supports not (animation-timeline: scroll()) {
    #navbar.navbar-scrolled .nav-pill {
      --navbar-fill: 1;
    }
  }

  /* Con reduced-motion se vuelve a la ruta por clase: el `animation-duration: 0.01ms
     !important` de global.css completaría la animación de entrada y la píldora
     arrancaría llena desde el top. */
  @media (prefers-reduced-motion: reduce) {
    .nav-pill {
      animation: none;
    }

    #navbar.navbar-scrolled .nav-pill {
      --navbar-fill: 1;
    }
  }

  .mobile-menu {
    background: rgba(11, 11, 11, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--border-accent);
    border-radius: 14px;
  }

  /* ── Prompt de mobile ── */
  .nav-prompt {
    /* 0.8rem en vez de 0.875rem: con `ssh atarico@contacto` la línea entera son
       33 caracteres y a text-sm no entra en 375px junto al hamburguesa. */
    font-size: 0.8rem;
    /* Separa el texto de lo que pasa detrás del vidrio. */
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7);
  }

  /* El comando es lo único que cede: el nombre y el cursor no se recortan nunca
     (`shrink-0` en el markup), así que si falta lugar se corta el comando. */
  .nav-cmd {
    min-width: 0;
    margin-left: 0.4rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-accent);
  }

  /* En el hero no hay comando: sin esto quedaría un hueco doble entre `$` y `_`. */
  .nav-cmd:empty {
    margin-left: 0;
  }

  /* ── Desktop link: línea animada al hover ── */
  .nav-link {
    position: relative;
    padding-bottom: 2px;
    /* Separa el texto de lo que pasa detrás del vidrio. El activo lo reemplaza por
       su brillo verde. */
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--text-accent);
    box-shadow: var(--glow-sm);
    transition: width 0.25s ease;
  }

  .nav-link:hover::after,
  .nav-link.nav-link--active::after {
    width: 100%;
  }

  /* ── Estado activo ── */
  .nav-link--active {
    color: var(--text-accent) !important;
    text-shadow: var(--glow-sm);
  }

  .mobile-link.nav-link--active {
    color: var(--text-accent) !important;
  }

  /* ── Focus visible para teclado ── */
  .nav-link:focus-visible,
  .mobile-link:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  #menu-toggle:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
