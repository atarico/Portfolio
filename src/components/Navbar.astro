---
const links = [
  { href: '#experience', label: 'Experiencia' },
  { href: '#projects',   label: 'Proyectos'   },
  { href: '#about',      label: 'Sobre mí'    },
  { href: '#tech',       label: 'Skills'      },
  { href: '#contact',    label: 'Contacto'    },
];

// El scrollspy solo observa las secciones que tienen link en el menú; `#hero` queda
// fuera a propósito, porque el tope de la página no marca ninguna.
const navSectionIds = links.map(({ href }) => href.slice(1));
---

<!-- Barra flotante centrada, al estilo porfolio.dev.
     `data-sections` viaja por atributo y no por `define:vars`: eso último obligaría a
     un script inline, y el CSP de vercel.json solo permite `script-src 'self'`. -->
<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 flex flex-col items-center px-4 pt-3"
  data-sections={navSectionIds.join(',')}
>
  <nav
    class="nav-pill flex items-center gap-3 md:gap-5 px-4 md:px-5 py-2 transition-all duration-300"
    aria-label="Navegación principal"
  >
    <!-- Logo: prompt de terminal. Solo en mobile, donde los links viven en el
         desplegable y la píldora quedaría vacía. -->
    <a
      href="#hero"
      class="logo md:hidden flex items-center font-mono text-sm select-none"
      aria-label="Agustín Tarico — inicio"
    >
      <span class="text-muted" aria-hidden="true">~/</span>
      <span class="text-accent font-medium">atarico</span>
      <span class="text-muted ml-2" aria-hidden="true">$</span>
      <span class="cursor-blink ml-1 text-accent font-bold" aria-hidden="true">_</span>
    </a>

    <!-- Desktop navigation -->
    <ul class="hidden md:flex items-center gap-5" role="list">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="nav-link text-muted hover:text-accent text-sm tracking-wider uppercase transition-colors duration-200"
            aria-current="false"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Hamburger button (mobile) -->
    <button
      id="menu-toggle"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden flex flex-col justify-center gap-1.25 w-8 h-8 p-1 text-accent rounded"
    >
      <span class="hamburger-bar block w-full h-px bg-current origin-center transition-all duration-300"></span>
      <span class="hamburger-bar block w-full h-px bg-current transition-all duration-300"></span>
      <span class="hamburger-bar block w-full h-px bg-current origin-center transition-all duration-300"></span>
    </button>
  </nav>

  <!-- Mobile menu: panel flotante debajo de la píldora -->
  <div
    id="mobile-menu"
    class="mobile-menu hidden md:hidden w-full max-w-sm mt-2"
    role="navigation"
    aria-label="Menú de navegación móvil"
  >
    <ul class="flex flex-col py-3 px-5" role="list">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="mobile-link block text-muted hover:text-accent text-sm tracking-widest uppercase transition-colors duration-200 py-3 border-b border-(--border-accent) last:border-0"
            aria-current="false"
          >
            <span class="text-accent opacity-60 mr-2 font-bold" aria-hidden="true">&gt;</span>{label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const navbar     = document.getElementById('navbar')!;
  const toggle     = document.getElementById('menu-toggle')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const bars       = navbar.querySelectorAll<HTMLElement>('.hamburger-bar');

  /* ────────────────────────────────────────────────
   * Hamburger menu
   * ──────────────────────────────────────────────── */
  let open = false;

  const closeMenu = () => {
    if (!open) return;
    open = false;
    toggle.setAttribute('aria-expanded', 'false');
    mobileMenu.classList.add('hidden');
    document.body.style.overflow = '';
    bars[0]!.style.transform = '';
    bars[1]!.style.opacity   = '1';
    bars[2]!.style.transform = '';
  };

  const openMenu = () => {
    open = true;
    toggle.setAttribute('aria-expanded', 'true');
    mobileMenu.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    bars[0]!.style.transform = 'translateY(6px) rotate(45deg)';
    bars[1]!.style.opacity   = '0';
    bars[2]!.style.transform = 'translateY(-6px) rotate(-45deg)';
  };

  toggle.addEventListener('click', () => (open ? closeMenu() : openMenu()));

  // Cerrar al hacer click/tap fuera del navbar
  document.addEventListener('click', (e) => {
    if (open && !navbar.contains(e.target as Node)) closeMenu();
  });

  // Cerrar al hacer click en un link del menú mobile
  mobileMenu.querySelectorAll('.mobile-link').forEach(link =>
    link.addEventListener('click', closeMenu)
  );

  // Cerrar con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) closeMenu();
  });

  /* ────────────────────────────────────────────────
   * Scrollspy: sección activa según posición de scroll
   * ──────────────────────────────────────────────── */
  // Solo las secciones que tienen link en el menú, en orden de documento. Se filtra por
  // `section[id]` (y no por el orden del menú) para que un reorden de la página no
  // desincronice la búsqueda de "última sección que cruzó la línea".
  const navSectionIds = (navbar.dataset.sections ?? '').split(',').filter(Boolean);
  const sections = [...document.querySelectorAll<HTMLElement>('section[id]')]
    .filter((section) => navSectionIds.includes(section.id));

  const desktopLinks = navbar.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const mobileLinks  = mobileMenu.querySelectorAll<HTMLAnchorElement>('.mobile-link');
  const allNavLinks  = [...desktopLinks, ...mobileLinks];

  const setActive = (id: string) => {
    allNavLinks.forEach((link) => {
      const isActive = link.getAttribute('href') === `#${id}`;
      link.classList.toggle('nav-link--active', isActive);
      link.setAttribute('aria-current', isActive ? 'true' : 'false');
    });
  };

  const getActiveSection = () => {
    // Si llegamos al final de la página, la última sección es la activa aunque
    // su top no haya cruzado la línea de referencia (secciones cortas al pie).
    const scrolledToBottom =
      window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    if (scrolledToBottom) {
      return sections[sections.length - 1]?.id ?? '';
    }

    // Línea de referencia en el centro del viewport: una sección se marca activa
    // cuando su top la cruza, es decir, cuando ya domina lo que el usuario ve.
    // Robusto tanto para secciones cortas como más altas que el viewport.
    // Cadena vacía = ninguna sección del menú domina todavía (estamos en el hero).
    const line = window.innerHeight / 2;
    let current = '';
    sections.forEach((section) => {
      if (section.getBoundingClientRect().top <= line) {
        current = section.id;
      }
    });
    return current;
  };

  /* ────────────────────────────────────────────────
   * Scroll: fondo semi-transparente + scrollspy.
   * Un solo listener, throttled con requestAnimationFrame.
   * ──────────────────────────────────────────────── */
  let lastActive = '';

  const onScroll = () => {
    navbar.classList.toggle('navbar-scrolled', window.scrollY > 30);
    const current = getActiveSection();
    if (current !== lastActive) {
      lastActive = current;
      setActive(current);
    }
  };

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      onScroll();
      ticking = false;
    });
  }, { passive: true });

  // Al redimensionar: cerrar el menú mobile si se pasa al layout desktop (el CSS
  // lo oculta en md pero el body quedaría sin scroll) y refrescar el scrollspy
  // sin esperar al próximo scroll.
  // 768px = breakpoint `md` de Tailwind, el mismo que oculta el menú.
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) closeMenu();
    onScroll();
  }, { passive: true });

  // Estado inicial correcto sin esperar al primer scroll
  onScroll();
</script>

<style>
  /* El fondo del navbar se deriva por completo de `--navbar-fill` (0 → 1, registrada
     en global.css). Así el estado "lleno" se declara una sola vez y las dos rutas de
     abajo solo mueven el número.
     El borde existe siempre a 1px transparente: animar `border-bottom-color` en vez
     de aparecer el borde evita que el contenido salte 1px al scrollear. */
  /* El header solo posiciona; el fondo vive en la píldora flotante. */
  #navbar {
    pointer-events: none;
  }

  .nav-pill,
  .mobile-menu {
    pointer-events: auto;
  }

  /* El fondo se deriva por completo de `--navbar-fill` (0 → 1, registrada en
     global.css). Así el estado "lleno" se declara una sola vez y las dos rutas de
     abajo solo mueven el número. */
  .nav-pill {
    border-radius: 9999px;
    background: rgba(10, 10, 10, calc(0.88 * var(--navbar-fill)));
    backdrop-filter: blur(calc(14px * var(--navbar-fill)));
    -webkit-backdrop-filter: blur(calc(14px * var(--navbar-fill)));
    border: 1px solid rgba(0, 255, 65, calc(0.25 * var(--navbar-fill)));
    box-shadow: 0 4px 24px rgba(0, 255, 65, calc(0.04 * var(--navbar-fill)));
  }

  /* Ruta moderna: el fondo aparece gradual, atado a la posición de scroll. */
  @keyframes navbar-fill {
    to {
      --navbar-fill: 1;
    }
  }

  @supports (animation-timeline: scroll()) {
    .nav-pill {
      animation: navbar-fill linear forwards;
      animation-timeline: scroll();
      animation-range: 0 120px;
    }
  }

  /* Fallback: el script agrega `.navbar-scrolled` a los 30px y la transición del
     header lo suaviza.
     Va dentro de `@supports not` a propósito: una declaración normal le gana a la
     animación sobre `--navbar-fill`, así que si la clase aplicara en la ruta moderna
     el fondo saltaría a full apenas cruza los 30px y el degradado no se vería. */
  @supports not (animation-timeline: scroll()) {
    #navbar.navbar-scrolled .nav-pill {
      --navbar-fill: 1;
    }
  }

  /* Con reduced-motion se vuelve a la ruta por clase: el `animation-duration: 0.01ms
     !important` de global.css completaría la animación de entrada y la píldora
     arrancaría llena desde el top. */
  @media (prefers-reduced-motion: reduce) {
    .nav-pill {
      animation: none;
    }

    #navbar.navbar-scrolled .nav-pill {
      --navbar-fill: 1;
    }
  }

  .mobile-menu {
    background: rgba(11, 11, 11, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--border-accent);
    border-radius: 14px;
  }

  /* ── Desktop link: línea animada al hover ── */
  .nav-link {
    position: relative;
    padding-bottom: 2px;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--text-accent);
    box-shadow: var(--glow-sm);
    transition: width 0.25s ease;
  }

  .nav-link:hover::after,
  .nav-link.nav-link--active::after {
    width: 100%;
  }

  /* ── Estado activo ── */
  .nav-link--active {
    color: var(--text-accent) !important;
    text-shadow: var(--glow-sm);
  }

  .mobile-link.nav-link--active {
    color: var(--text-accent) !important;
  }

  /* ── Focus visible para teclado ── */
  .nav-link:focus-visible,
  .mobile-link:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  #menu-toggle:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
